{
  "name": "GitHub → Strapi Projects Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "minutesInterval": 6 }]
        }
      },
      "id": "schedule-trigger",
      "name": "Toutes les 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/search/repositories?q=user:{{ $env.GITHUB_USERNAME }}+topic:{{ $env.GITHUB_PORTFOLIO_TOPIC }}&per_page=100&sort=created&order=desc",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "Authorization", "value": "=Bearer {{ $env.GITHUB_TOKEN }}" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        }
      },
      "id": "github-search",
      "name": "GitHub Search API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "split-repos",
      "name": "Split Repos",
      "type": "n8n-nodes-base.splitOut",
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "fork-filter",
              "leftValue": "={{ $json.fork }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ]
        }
      },
      "id": "filter-forks",
      "name": "Ignore les forks",
      "type": "n8n-nodes-base.filter",
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.STRAPI_URL }}/api/projets?filters[github_id][$eq]={{ $json.id }}&pagination[limit]=1&status=draft",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.STRAPI_TOKEN }}" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "check-existing",
      "name": "Cherche dans Strapi",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "exists-check",
              "leftValue": "={{ $json.meta.pagination.total }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "notEquals" }
            }
          ]
        }
      },
      "id": "exists-or-not",
      "name": "Existe déjà ?",
      "type": "n8n-nodes-base.if",
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.STRAPI_URL + '/api/projets/' + $json.data[0].documentId + '?status=published' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.STRAPI_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": {\n    \"name\": \"{{ $('Split Repos').item.json.name }}\",\n    \"description\": {{ JSON.stringify($('Split Repos').item.json.description) }},\n    \"github_url\": \"{{ $('Split Repos').item.json.html_url }}\",\n    \"topics\": {{ JSON.stringify($('Split Repos').item.json.topics) }},\n    \"creation_date\": \"{{ $('Split Repos').item.json.created_at }}\",\n    \"image_url\": \"https://raw.githubusercontent.com/{{ $('Split Repos').item.json.full_name }}/{{ $('Split Repos').item.json.default_branch }}/preview.png\"\n  }\n}"
      },
      "id": "update-project",
      "name": "Mettre à jour Strapi",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1560, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STRAPI_URL }}/api/projets?status=published",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.STRAPI_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": {\n    \"github_id\": {{ $('Split Repos').item.json.id }},\n    \"name\": \"{{ $('Split Repos').item.json.name }}\",\n    \"description\": {{ JSON.stringify($('Split Repos').item.json.description) }},\n    \"github_url\": \"{{ $('Split Repos').item.json.html_url }}\",\n    \"topics\": {{ JSON.stringify($('Split Repos').item.json.topics) }},\n    \"creation_date\": \"{{ $('Split Repos').item.json.created_at }}\",\n    \"image_url\": \"https://raw.githubusercontent.com/{{ $('Split Repos').item.json.full_name }}/{{ $('Split Repos').item.json.default_branch }}/preview.png\"\n  }\n}"
      },
      "id": "create-project",
      "name": "Créer dans Strapi",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1560, 420]
    }
  ],
  "connections": {
    "Toutes les 6h": {
      "main": [[{ "node": "GitHub Search API", "type": "main", "index": 0 }]]
    },
    "GitHub Search API": {
      "main": [[{ "node": "Split Repos", "type": "main", "index": 0 }]]
    },
    "Split Repos": {
      "main": [[{ "node": "Ignore les forks", "type": "main", "index": 0 }]]
    },
    "Ignore les forks": {
      "main": [[{ "node": "Cherche dans Strapi", "type": "main", "index": 0 }]]
    },
    "Cherche dans Strapi": {
      "main": [[{ "node": "Existe déjà ?", "type": "main", "index": 0 }]]
    },
    "Existe déjà ?": {
      "main": [
        [{ "node": "Mettre à jour Strapi", "type": "main", "index": 0 }],
        [{ "node": "Créer dans Strapi", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
