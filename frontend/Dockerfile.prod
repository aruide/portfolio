# ── Stage 1 : build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# VITE_API_URL doit être connu au build (Vite le bake dans le bundle)
ARG VITE_API_URL=http://localhost:1337
ARG VITE_API_TOKEN

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_API_TOKEN=$VITE_API_TOKEN

WORKDIR /app
COPY package.json package-lock.json* ./
# Installer toutes les deps (dont devDeps : vite, typescript...)
RUN npm install
COPY . .
# Build en mode production (évite l'import des plugins visual-editor qui n'existent pas)
RUN NODE_ENV=production npm run build

# ── Stage 2 : serve ───────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/build /usr/share/nginx/html

# Config nginx : renvoie toujours index.html pour le routing React
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
