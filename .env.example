# ─── Backend Strapi ───────────────────────────────────────────────────────────
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337
NODE_ENV=development

# Génère avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Base de données SQLite
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ─── Frontend Vite ─────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:1337
VITE_API_TOKEN=

# ─── File watching (Windows / WSL2) ───────────────────────────────────────────
CHOKIDAR_USEPOLLING=true
VITE_POLL=true

# ─── GitHub Sync (n8n / cron) ─────────────────────────────────────────────────
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_PORTFOLIO_TOPIC=portfolio
N8N_STRAPI_TOKEN=

# ─── Production uniquement (docker-compose.prod.yml) ─────────────────────────
# URL publique de Strapi vue depuis le navigateur (ex: https://strapi.mondomaine.com)
# VITE_API_URL=https://strapi.mondomaine.com
# Domaine n8n (ex: n8n.mondomaine.com)
# N8N_HOST=n8n.mondomaine.com
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://n8n.mondomaine.com/
